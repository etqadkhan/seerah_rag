# =============================================================================
# Seerah Q&A Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# cp env.example .env

# Google Gemini API Key (Required)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# Access Control (Required for restricted registration)
# =============================================================================

# Comma-separated list of allowed usernames (only these users can register)
# Example: dad,mom,brother,sister
ALLOWED_USERNAMES=

# Maximum number of users allowed (backup limit)
MAX_USERS=10

# =============================================================================
# Optional Settings (defaults are usually fine)
# =============================================================================

# Database Configuration
# DATABASE_PATH=data/seerah.db

# ChromaDB Configuration  
# CHROMA_DB_PATH=data/chroma_db

# Transcripts Directory
# TRANSCRIPTS_DIR=data/transcripts

# YouTube Playlist URL (Yasir Qadhi's Seerah)
# PLAYLIST_URL=https://youtube.com/playlist?list=PLLN02x1UwIfLvnUiycprqWOG0M_dp8cOL

# Debug Mode (set to True for verbose logging)
# DEBUG=False

SUPADATA_API_KEY=supadata-api-key